__pycache__/
venv/
*.pyc
.pytest_cache/
*.mid
*.wav
*.xlsx
.vscode/
.idea/
.coverage
htmlcov/
.ruff_cache/

# Generated by tools/analyze_transcription.py: cached inference, MIDI renders, metrics.
analysis/

# Third-party evaluation corpora (GuitarSet is ~660MB); fetched, never edited.
data/

# Test fixtures must be tracked -- otherwise the suite cannot run on a fresh
# clone. Only the input WAVs are fixtures; every .mid in tests/ is generated
# output, so those stay ignored.
!tests/*.wav
